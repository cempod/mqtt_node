menu "MQTT node configuration"
    config MQTT_NODE_NAME
        string "Node name"
        default "MQTT node"
    config MQTT_BROKER_URI
        string "MQTT Broker URI"
        default "mqtts://192.168.1.100:8883"
    config ESP_WIFI_SSID
        string "Wi-Fi SSID"
        default "MySSID"
    config ESP_WIFI_PASSWORD
        string "Wi-Fi Password"
        default "MyPassword"
    config ESP_BOARD_RGB_LED_PIN
        int "RGB_LED_PIN"
        default 38
endmenu